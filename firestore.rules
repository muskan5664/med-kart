rules_version = '2';

// Matches the live app schema: users / products / orders.
// Admin = admin@medkart.in account OR a users doc with role == 'admin'
// (role can only be set to 'admin' by an admin, or at creation by the admin email itself).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'admin@medkart.in';
    }

    function isAdmin() {
      return isAdminEmail() || (
        signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isVerifiedRmp() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verified == true;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['uid', 'email', 'doctorName', 'clinicName', 'rmpNo', 'phone', 'address', 'role', 'verified', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && (
          (request.resource.data.role == 'rmp' && request.resource.data.verified == false)
          || (isAdminEmail() && request.resource.data.role == 'admin')
        );

      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['doctorName', 'clinicName', 'phone', 'address'])
      );

      allow delete: if isAdmin();
    }

    // ---------- products (public catalog, admin-managed) ----------
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- orders ----------
    match /orders/{orderId} {
      allow get: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if signedIn()
        && (isVerifiedRmp() || isAdmin())
        && request.resource.data.keys().hasOnly(
          ['userId', 'userEmail', 'doctorName', 'clinicName', 'rmpNo', 'phone', 'address', 'items',
           'subtotal', 'gstTotal', 'grandTotal', 'paymentMode', 'paymentStatus', 'utrNumber', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Confirmed'
        && request.resource.data.paymentStatus == 'Pending'
        && request.resource.data.paymentMode in ['UPI_QR', 'COD']
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 200
        && request.resource.data.grandTotal is number
        && request.resource.data.grandTotal >= 0
        && request.resource.data.subtotal is number
        && request.resource.data.gstTotal is number;

      // Only admin may change fulfilment/payment state; customers can never edit orders.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'paymentStatus', 'cancelReason']);

      allow delete: if isAdmin();
    }

    // everything else is denied by default
  }
}
